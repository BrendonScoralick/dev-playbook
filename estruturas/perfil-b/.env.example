# Copie para .env e preencha. Nunca versione o .env.
# Valores abaixo são exemplos para ambiente LOCAL (Supabase local ou projeto de desenvolvimento).

# Públicas: vão para o navegador (prefixo NEXT_PUBLIC_). Só a chave PUBLICÁVEL pode estar aqui.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_exemplo

# Secreta: SÓ no servidor (backend/src/supabase/admin.ts). Ignora a RLS.
# NUNCA use prefixo NEXT_PUBLIC_ nesta variável.
SUPABASE_SECRET_KEY=sb_secret_exemplo
