{
  "extraKnownMarketplaces": {
    "dev-playbook": {
      "source": { "source": "github", "repo": "<repositorio-do-playbook>" }
    }
  },
  "enabledPlugins": {
    "dev-playbook@dev-playbook": true
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.production)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "shell": "bash",
            "command": "npm run verificar --silent >&2 || { echo 'Commit bloqueado: lint, tipos ou testes falharam. Corrija e tente de novo; nao altere testes para passar.' >&2; exit 2; }",
            "timeout": 600,
            "statusMessage": "Verificando lint, tipos e testes antes do commit..."
          }
        ]
      }
    ]
  }
}
