# Copie para .env e preencha. Nunca versione o .env.
# Valores abaixo são exemplos para ambiente LOCAL.

# Banco local (docker-compose.yml)
POSTGRES_USER=app_usuario
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=sistema_dev
DATABASE_URL=postgresql://app_usuario:troque-esta-senha@localhost:5432/sistema_dev

# Sessão
JWT_ACCESS_SECRET=gere-um-valor-aleatorio-longo
JWT_REFRESH_SECRET=gere-outro-valor-aleatorio-longo
JWT_ACCESS_TTL=15m

# Frontend
FRONTEND_ORIGIN=http://localhost:3000
